rules_version = '2';

// Chaque utilisateur connecté ne peut lire et écrire que ses propres données,
// rangées sous users/{son identifiant}/. Tout le reste est refusé.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
